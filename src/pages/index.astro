---
import "../styles.css";

// Landing page: the one thing a student does before anything else in the
// core flow (see CLAUDE.md) — enter a Student ID. The POST here doesn't
// touch the database itself; it just normalises the id and hands off to
// /plan/[studentId], which is the single place get-or-create happens (on
// GET, so a bookmarked or refreshed plan URL behaves the same way).
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const studentId = String(form.get("studentId") ?? "").trim();
  if (studentId) {
    return Astro.redirect(`/plan/${encodeURIComponent(studentId.slice(0, 100))}`, 303);
  }
  error = "Enter a Student ID to continue.";
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Semester Planner</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">ANU Semester Planner</a>
      <nav aria-label="site">
        <a href="/readme/">About</a>
      </nav>
    </header>
    <main>
      <section class="hero">
        <h1>Plan your semester in one place</h1>
        <p class="lede">
          Course codes, availability and study load, side by side — instead of
          hunting across separate ANU pages. Enter a Student ID to open a
          saved plan, or start a new one.
        </p>

        <div class="hero-card">
          <form method="post" class="id-form">
            <label for="studentId">Student ID</label>
            <div class="field-row">
              <input
                id="studentId"
                name="studentId"
                required
                maxlength="100"
                autocomplete="off"
                aria-describedby="studentId-hint"
                placeholder="e.g. u1234567"
              />
              <button>Open my plan</button>
            </div>
            <p id="studentId-hint" class="field-hint">
              Used only to find or create your saved plan — it is not a
              password, and there is no ANU login.
            </p>
          </form>
          {
            error && (
              <p role="alert" class="status status-error">
                {error}
              </p>
            )
          }
        </div>

        <ul class="how-it-works">
          <li>
            <span class="step-index" aria-hidden="true">1</span>
            <div>
              <strong>Enter your Student ID</strong>
              <p>We'll open your saved plan, or create a new one.</p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">2</span>
            <div>
              <strong>Browse the catalogue</strong>
              <p>A small set of representative computing courses.</p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">3</span>
            <div>
              <strong>Build your plan</strong>
              <p>Add courses to Semester 1 or 2 and track unit totals.</p>
            </div>
          </li>
        </ul>
      </section>
    </main>
  </body>
</html>
