---
import "../styles.css";

// Landing page: the one thing a student does before anything else in the
// core flow (see CLAUDE.md) — enter a Student ID. The POST here doesn't
// touch the database itself; it just normalises the id and hands off to
// /plan/[studentId], which is the single place get-or-create happens (on
// GET, so a bookmarked or refreshed plan URL behaves the same way).
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const studentId = String(form.get("studentId") ?? "").trim();
  if (studentId) {
    return Astro.redirect(`/plan/${encodeURIComponent(studentId.slice(0, 100))}`, 303);
  }
  error = "Enter a Student ID to continue.";
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Semester Planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>ANU Semester Planner</h1>
      <p>
        Enter your Student ID to open your semester plan. If you don't have one
        yet, we'll create it — the same Student ID always returns to the same
        plan.
      </p>
      <form method="post">
        <label for="studentId">Student ID</label>
        <input id="studentId" name="studentId" required maxlength="100" autocomplete="off" />
        <button>Open my plan</button>
      </form>
      {error && (
        <p role="alert" class="status status-error">
          {error}
        </p>
      )}
      <p class="note">
        Student ID is just an identifier for this prototype — it is not a
        password, and there is no login.
      </p>
    </main>
  </body>
</html>
